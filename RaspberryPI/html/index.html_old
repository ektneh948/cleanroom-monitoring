<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>클린룸 모니터링 프로젝트 · 대시보드</title>
  <style>
    :root{
      --bg:#0b1020; --card:#121933; --muted:#94a3b8; --text:#e2e8f0; --accent:#60a5fa; --ok:#22c55e; --warn:#f59e0b; --err:#ef4444;
      --border: rgba(255,255,255,.08);
    }
    [data-theme="light"]{ --bg:#f8fafc; --card:#ffffff; --text:#0f172a; --muted:#475569; --accent:#2563eb; --border:#e5e7eb; }
    html,body{height:100%;}
    body{margin:0;background:radial-gradient(1200px 600px at 10% -10%, rgba(96,165,250,.12), transparent 40%),var(--bg);color:var(--text);font:15px/1.45 system-ui,-apple-system,Segoe UI,Roboto,Helvetica,Arial,"Apple SD Gothic Neo","Noto Sans KR",sans-serif;}
    .wrap{max-width:1280px;margin:0 auto;padding:18px;}
    header{display:flex;align-items:center;gap:14px;justify-content:space-between;margin-bottom:14px}
    .title{display:flex;align-items:center;gap:12px}
    .dot{width:10px;height:10px;border-radius:50%;background:var(--ok);box-shadow:0 0 10px var(--ok)}
    .subtitle{color:var(--muted);font-weight:500}
    .tag{padding:4px 8px;border:1px solid var(--border);border-radius:999px;color:var(--muted);font-size:12px}
    .controls{display:flex;gap:10px;flex-wrap:wrap}
    button,.select{background:transparent;border:1px solid var(--border);color:var(--text);padding:8px 12px;border-radius:10px;cursor:pointer}
    button:hover{border-color:var(--accent)}
    .grid{display:grid;grid-template-columns:1fr 1.2fr;gap:14px}
    @media (max-width: 980px){.grid{grid-template-columns:1fr}}
    .card{background:linear-gradient(0deg, rgba(255,255,255,.03), rgba(255,255,255,0));border:1px solid var(--border);border-radius:16px;box-shadow:0 2px 16px rgba(0,0,0,.06);overflow:hidden}
    .card .head{display:flex;align-items:center;justify-content:space-between;padding:12px 14px;border-bottom:1px solid var(--border);}
    .card .head h2{font-size:15px;margin:0;color:var(--text)}
    .card .head .right{display:flex;gap:8px;align-items:center}
    .card .body{padding:0}
    .frame-wrap{position:relative;background:#ffffff}
    iframe{display:block;width:100%;height:540px;border:0;background:#ffffff}
    .note{padding:10px 14px;color:var(--muted);font-size:13px;border-top:1px dashed var(--border)}
    /* fullscreen overlay */
    .fullscreen{position:fixed;inset:10px;z-index:9999;background:var(--card);border-radius:16px;border:1px solid var(--border);}
    .fullscreen iframe{height:calc(100vh - 120px)}
    .kpi{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin:14px 0}
    .tile{background:linear-gradient(0deg, rgba(255,255,255,.04), rgba(255,255,255,0));border:1px solid var(--border);border-radius:12px;padding:12px}
    .tile .label{color:var(--muted);font-size:12px}
    .tile .val{font-size:22px;font-weight:700}
  </style>
</head>
<body>
  <div class="wrap" id="app">
    <header>
      <div class="title">
        <div class="dot" title="연결됨"></div>
        <div>
          <div style="font-size:18px;font-weight:800">클린룸 모니터링 프로젝트 · 대시보드</div>
          <div class="subtitle">센서 테이블 & 실시간 그래프 · 서버 <span class="tag">10.10.14.62</span> · <span class="tag" id="clock">--:--:--</span></div>
        </div>
      </div>
      <div class="controls">
        <label class="select">자동 새로고침
          <select id="autoEvery" style="margin-left:6px;background:transparent;border:0;color:inherit">
            <option value="0">끄기</option>
            <option value="15000">15초</option>
            <option value="30000" selected>30초</option>
            <option value="60000">60초</option>
          </select>
        </label>
        <button id="refreshAll">전체 새로고침</button>
        <button id="themeBtn" title="밝게/어둡게">테마 전환</button>
      </div>
    </header>

    <section class="kpi" aria-hidden="true">
      <div class="tile"><div class="label">마지막 새로고침</div><div class="val" id="lastRefresh">--:--:--</div></div>
      <div class="tile"><div class="label">자동 새로고침</div><div class="val" id="autoStatus">OFF</div></div>
      <div class="tile"><div class="label">테마</div><div class="val" id="themeName">Dark</div></div>
      <div class="tile"><div class="label">프레임 상태</div><div class="val" id="frameState">OK</div></div>
    </section>

    <div class="grid">
      <!-- 센서 테이블 -->
      <article class="card" id="cardTable">
        <div class="head">
          <h2>센서 테이블</h2>
          <div class="right">
            <button data-action="reload" data-target="frameTable">새로고침</button>
            <button data-action="fullscreen" data-target="cardTable">전체화면</button>
          </div>
        </div>
        <div class="body frame-wrap">
          <iframe id="frameTable" src="http://10.10.14.62/sensorTable.php" loading="lazy" referrerpolicy="no-referrer"></iframe>
        </div>
      </article>

      <!-- 실시간 그래프 -->
      <article class="card" id="cardGraph">
        <div class="head">
          <h2>시간별 그래프</h2>
          <div class="right">
            <button data-action="reload" data-target="frameGraph">새로고침</button>
            <button data-action="fullscreen" data-target="cardGraph">전체화면</button>
          </div>
        </div>
        <div class="body frame-wrap">
          <iframe id="frameGraph" src="http://10.10.14.62/sensorGraph.php" loading="lazy" referrerpolicy="no-referrer"></iframe>
        </div>
      </article>
    </div>
  </div>

  <script>
    // --- 테마 ---
    const root = document.documentElement;
    const themeBtn = document.getElementById('themeBtn');
    function setTheme(t){ document.body.setAttribute('data-theme', t); localStorage.setItem('dash.theme', t); document.getElementById('themeName').textContent = t==='light'?'Light':'Dark'; }
    setTheme(localStorage.getItem('dash.theme') || 'dark');
    themeBtn.addEventListener('click', ()=> setTheme((document.body.getAttribute('data-theme')==='light')?'dark':'light'));

    // --- 시계 ---
    function pad(n){return n<10?'0'+n:n}
    function tick(){ const d=new Date(); document.getElementById('clock').textContent = [pad(d.getHours()),pad(d.getMinutes()),pad(d.getSeconds())].join(':'); }
    setInterval(tick, 1000); tick();

    // --- 새로고침 로직 ---
    const frameTable = document.getElementById('frameTable');
    const frameGraph = document.getElementById('frameGraph');

    function reloadFrame(id){
      const el = document.getElementById(id);
      if(!el) return;
      // cache busting 쿼리 추가
      const url = new URL(el.src);
      url.searchParams.set('_t', Date.now());
      el.src = url.toString();
    }
    function refreshAll(){ reloadFrame('frameTable'); reloadFrame('frameGraph');
      const d=new Date(); document.getElementById('lastRefresh').textContent = [pad(d.getHours()),pad(d.getMinutes()),pad(d.getSeconds())].join(':'); }

    document.getElementById('refreshAll').addEventListener('click', refreshAll);
    document.querySelectorAll('button[data-action="reload"]').forEach(btn=>{
      btn.addEventListener('click', ()=> reloadFrame(btn.dataset.target));
    });

    // --- 전체화면 토글 ---
    document.querySelectorAll('button[data-action="fullscreen"]').forEach(btn=>{
      btn.addEventListener('click', ()=>{
        const card = document.getElementById(btn.dataset.target);
        card.classList.toggle('fullscreen');
      });
    });

    // --- 자동 새로고침 ---
    const sel = document.getElementById('autoEvery');
    let timer = null;
    function setAuto(ms){
      if (timer) { clearInterval(timer); timer=null; }
      if (ms && ms>0) { timer = setInterval(refreshAll, ms); document.getElementById('autoStatus').textContent = (ms/1000)+'s'; }
      else { document.getElementById('autoStatus').textContent = 'OFF'; }
      localStorage.setItem('dash.auto', String(ms||0));
    }
    sel.value = localStorage.getItem('dash.auto') || '30000';
    setAuto(parseInt(sel.value,10));
    sel.addEventListener('change', ()=> setAuto(parseInt(sel.value,10)));

    // --- 프레임 로드 상태 (간단 표시) ---
    function watchFrame(fr){
      let ok = true;
      const id = setTimeout(()=>{ ok=false; document.getElementById('frameState').textContent='시간초과'; }, 8000);
      fr.addEventListener('load', ()=>{ clearTimeout(id); document.getElementById('frameState').textContent = ok?'OK':'지연'; });
    }
    watchFrame(frameTable); watchFrame(frameGraph);
  </script>
</body>
</html>
